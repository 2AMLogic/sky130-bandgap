#### Project-local xschemrc for sky130-bandgap.
####
#### Purpose: make `xschem` find the sky130 symbol library without relying on
#### anything in the user's ~/.xschem. The corner runner passes this file with
#### `--rcfile`, so batch netlisting and interactive editing share one config.
####
#### Interactive use:
####   source sim/bin/pdk-env.sh          # exports PDK_ROOT / PDK
####   xschem --rcfile sim/xschemrc sim/<experiment>/testbench/<tb>.sch
####
#### Everything PDK-specific below is inherited from the PDK's own xschemrc
#### (which sets XSCHEM_LIBRARY_PATH so `sky130_fd_pr/*.sym` resolves, and
#### SKYWATER_MODELS for the corner.sym netlist command).

#### PDK_ROOT / PDK: honour the environment, else fall back to the volare
#### default root. Keep the fallback in sync with sim/pdk.json.
if {![info exists env(PDK_ROOT)] || $env(PDK_ROOT) eq {}} {
  set env(PDK_ROOT) [file normalize ~/.volare]
}
if {![info exists env(PDK)] || $env(PDK) eq {}} {
  set env(PDK) sky130A
}

set _sky130_rc $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
if {![file exists $_sky130_rc]} {
  puts stderr "sky130-bandgap: no PDK xschemrc at $_sky130_rc"
  puts stderr "sky130-bandgap: install the pinned PDK (see sim/README.md) or set PDK_ROOT"
} else {
  source $_sky130_rc
}
unset _sky130_rc

#### Keep xschem's generated netlists out of the tracked tree. The corner
#### runner overrides this with an explicit `-o`, so this only affects
#### interactive netlisting from the GUI.
set netlist_dir [file normalize [file join [file dirname [info script]] build xschem]]
file mkdir $netlist_dir

#### Do not open the PDK's demo schematic when started with no file argument.
set XSCHEM_START_WINDOW {}
