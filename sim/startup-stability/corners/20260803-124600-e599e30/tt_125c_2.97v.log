| let meas_imin_off_bare = vecmin(abs(ifbare[225,250]))
| let meas_i_off_su = ifsu[250]
| let meas_i_off_bare = ifbare[250]
| let meas_i_on_su = ifsu[0]
| let meas_i_su_standing = i(vpsu)[0]
| let meas_i_standing = i(v2)[0] - i(v1)[0]
| let meas_dvref = v(vrefd)[0] - v(vrefr)[0]
| let meas_vref_dut = v(vrefd)[0]
| let meas_vgdrv_dut = v(gd)[0]
| let meas_isup_dut = -i(v1)[0]
| let meas_ncross_bare = (250 - mean(sbare[0,249]*sbare[1,250])*250) / 2
| print meas_ncross_su
| print meas_alpha_eq
| print meas_itrav_min
| print meas_imin_off_su
| print meas_imin_off_bare
| print meas_i_off_su
| print meas_i_off_bare
| print meas_i_on_su
| print meas_i_su_standing
| print meas_i_standing
| print meas_dvref
| print meas_vref_dut
| print meas_vgdrv_dut
| print meas_isup_dut
| print meas_ncross_bare
| quit
| .endc
| .end

