| let ssu = ifsu / (abs(ifsu) + 1e-18)
| let sbare = ifbare / (abs(ifbare) + 1e-18)
| let meas_ncross_su = (250 - mean(ssu[0,249]*ssu[1,250])*250) / 2
| let meas_alpha_eq = 1 - mean((ssu+1)/2)
