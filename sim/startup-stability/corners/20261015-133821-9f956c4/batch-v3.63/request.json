{
  "analysis": {
    "args": "valpha 0 1 0.004",
    "kind": "dc"
  },
  "backend": "batch",
  "batch": {
    "capacity_wait_s": 3600.0,
    "poll_interval_s": 30.0,
    "runner_version_check": "enforce"
  },
  "corners": {
    "process": [
      "tt",
      "ss",
      "ff",
      "sf",
      "fs"
    ],
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "engine": "ngspice",
  "measurements": [
    {
      "expr": "(250 - mean(((-i(vpsw)) / (abs((-i(vpsw))) + 1e-18))[0,249]*((-i(vpsw)) / (abs((-i(vpsw))) + 1e-18))[1,250])*250) / 2",
      "limits": {
        "max": 1.5,
        "min": 0.5
      },
      "name": "ncross_su"
    },
    {
      "expr": "1 - mean((((-i(vpsw)) / (abs((-i(vpsw))) + 1e-18))+1)/2)",
      "limits": {
        "max": 0.74,
        "min": 0.2
      },
      "name": "alpha_eq"
    },
    {
      "expr": "vecmin((-i(vpsw))[188,250])",
      "limits": {
        "min": 1e-09
      },
      "name": "itrav_min",
      "unit": "A"
    },
    {
      "expr": "vecmin(abs((-i(vpsw))[225,250]))",
      "limits": {
        "min": 1e-08
      },
      "name": "imin_off_su",
      "unit": "A"
    },
    {
      "expr": "vecmin(abs((-i(vpsn))[225,250]))",
      "limits": {
        "max": 1e-09
      },
      "name": "imin_off_bare",
      "unit": "A"
    },
    {
      "expr": "(-i(vpsw))[250]",
      "limits": {
        "min": 1e-06
      },
      "name": "i_off_su",
      "unit": "A"
    },
    {
      "expr": "(-i(vpsn))[250]",
      "limits": {
        "max": 1e-09
      },
      "name": "i_off_bare",
      "unit": "A"
    },
    {
      "expr": "(-i(vpsw))[0]",
      "limits": {
        "max": -1e-06
      },
      "name": "i_on_su",
      "unit": "A"
    },
    {
      "expr": "i(vpsu)[0]",
      "limits": {
        "max": 2e-07,
        "min": -1e-12
      },
      "name": "i_su_standing",
      "unit": "A"
    },
    {
      "expr": "i(v2)[0] - i(v1)[0]",
      "limits": {
        "max": 1e-06,
        "min": -1e-06
      },
      "name": "i_standing",
      "unit": "A"
    },
    {
      "expr": "v(vrefd)[0] - v(vrefr)[0]",
      "limits": {
        "max": 0.02,
        "min": -0.02
      },
      "name": "dvref",
      "unit": "V"
    },
    {
      "expr": "v(vrefd)[0]",
      "limits": {
        "max": 1.3,
        "min": 1.1
      },
      "name": "vref_dut",
      "unit": "V"
    },
    {
      "expr": "v(gd)[0]",
      "limits": {
        "max": 3.2,
        "min": 1.0
      },
      "name": "vgdrv_dut",
      "unit": "V"
    },
    {
      "expr": "-i(v1)[0]",
      "limits": {
        "max": 5e-05,
        "min": 5e-06
      },
      "name": "isup_dut",
      "unit": "A"
    },
    {
      "expr": "(250 - mean(((-i(vpsn)) / (abs((-i(vpsn))) + 1e-18))[0,249]*((-i(vpsn)) / (abs((-i(vpsn))) + 1e-18))[1,250])*250) / 2",
      "name": "ncross_bare"
    }
  ],
  "models": {
    "lib": "libs.tech/combined/sky130.lib.spice",
    "pdk": "sky130A"
  },
  "netlist": "netlist.cir",
  "options": {
    "keep_artifacts": true,
    "ngspice_init": [
      "set ngbehavior=hsa",
      "set skywaterpdk",
      "set ng_nomodcheck",
      "option noinit",
      "option klu"
    ],
    "timeout_s": 10800
  }
}
