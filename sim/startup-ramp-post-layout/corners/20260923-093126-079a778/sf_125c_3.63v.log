| .ENDS bandgap_core_routed
| .control
| save all
| tran 200n 2.5m uic
| meas tran t_vdd_s when v(vdds)=2.90 rise=1
| meas tran t_ref_s when v(vrefs)=1.05 rise=1
| meas tran t_vdd_f when v(vddf)=2.90 rise=1
| meas tran t_ref_f when v(vreff)=1.05 rise=1
| meas tran t_vdd_g when v(vddg)=2.90 rise=1
| meas tran t_ref_g when v(vrefg)=1.05 rise=1
| meas tran v_s find v(vrefs) at=2.45e-3
| meas tran v_f find v(vreff) at=2.45e-3
| meas tran v_g find v(vrefg) at=2.45e-3
| meas tran v_n find v(vrefn) at=2.45e-3
| meas tran g_n find v(gn) at=2.45e-3
| meas tran isg find i(vdeg) at=2.45e-3
| meas tran v_s1 find v(vrefs) at=1.45e-3
| meas tran v_f1 find v(vreff) at=1.45e-3
| meas tran v_g1 find v(vrefg) at=1.45e-3
| let meas_t_start_s = t_ref_s - t_vdd_s
| let meas_t_start_f = t_ref_f - t_vdd_f
| let meas_t_start_g = t_ref_g - t_vdd_g
| let meas_t_abs_s = t_ref_s
| let meas_vref_s = v_s
| let meas_vref_f = v_f
| let meas_vref_g = v_g
| let meas_vref_spread = abs(v_s - v_g) + abs(v_s - v_f)
| let meas_vref_spread_early = abs(v_s1 - v_g1) + abs(v_s1 - v_f1)
| let meas_vref_converge = (abs(v_s - v_g) + abs(v_s - v_f)) - (abs(v_s1 - v_g1) + abs(v_s1 - v_f1))
| let meas_vref_n = v_n
| let meas_gn_n = g_n
| let meas_isup_g = -isg
| print meas_t_start_s
| print meas_t_start_f
| print meas_t_start_g
| print meas_t_abs_s
| print meas_vref_s
| print meas_vref_f
| print meas_vref_g
| print meas_vref_spread
| print meas_vref_spread_early
| print meas_vref_converge
| print meas_vref_n
| print meas_gn_n
| print meas_isup_g
| quit
| .endc
| .end

