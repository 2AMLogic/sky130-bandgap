  "ci": {
    "workflow": ".github/workflows/ci.yml",
    "runs_on": [
      "push",
      "pull_request"
    ],
    "single_line_commands": [
      "pip install klayout",
      "npm run check:ci",
      "pip install \"klayout-tools==$(python3 scripts/ci/check_signoff_freshness.py --print-version)\"",
      "./scripts/ci/check-signoff-freshness.sh",
      "|",
      "|",
      "pip install --user ciel==2.6.1",
      "|",
      "|",
      "|"
    ],
    "entry_point": "npm run check:ci (package.json)"
  }
